{
  "name": "co-pilot-pops",
  "displayName": "Co-Co-Pilot",
  "description": "View, search and browse backed-up Copilot chat sessions",
  "version": "0.0.1",
  "publisher": "local-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/asos-dominicjomaa/co-copilot-pops"
  },
  "icon": "media/icon-marketplace.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "scripts": {
    "test": "jest",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "install-extension": ". $HOME/.nvm/nvm.sh && nvm use 20 && vsce package --no-dependencies --allow-missing-repository --skip-license && code --install-extension co-pilot-pops-0.0.1.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.32.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1"
  },
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilot-chat-viewer.open",
        "title": "Co-Co-Pilot: Open"
      },
      {
        "command": "copilot-chat-viewer.dev.installAndReload",
        "title": "Co-Co-Pilot: Install Extension and Reload Window"
      }
    ],
    "keybindings": [
      {
        "command": "copilot-chat-viewer.dev.installAndReload",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "isWorkspaceTrusted"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "co-pilot-pops",
          "title": "Co-Co-Pilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "co-pilot-pops": [
        {
          "type": "webview",
          "id": "copilotChatViewerSidebar",
          "name": "Workspaces"
        }
      ]
    },
    "configuration": {
      "title": "Co-Co-Pilot",
      "properties": {
        "copilotChatViewer.backupFolder": {
          "type": "string",
          "default": "",
          "description": "Path to the vscode-chats-backup folder."
        }
      }
    }
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}