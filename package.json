{
  "name": "copilot-chat-viewer",
  "displayName": "Copilot Chat Viewer",
  "description": "View, search and browse backed-up Copilot chat sessions",
  "version": "0.0.1",
  "publisher": "local-dev",
  "icon": "media/icon-marketplace.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "scripts": {
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "install-extension": "vsce package --no-dependencies --allow-missing-repository --skip-license && code --install-extension copilot-chat-viewer-0.0.1.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.32.0"
  },
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilot-chat-viewer.open",
        "title": "Copilot Chat Viewer: Open"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilot-chat-viewer",
          "title": "Copilot Chat Viewer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "copilot-chat-viewer": [
        {
          "type": "webview",
          "id": "copilotChatViewerSidebar",
          "name": "Chat History"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Chat Viewer",
      "properties": {
        "copilotChatViewer.backupFolder": {
          "type": "string",
          "default": "",
          "description": "Path to the vscode-chats-backup folder."
        }
      }
    }
  }
}